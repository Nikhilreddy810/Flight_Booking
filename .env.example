# Copy to .env and fill in real values. .env is git-ignored.
#   cp .env.example .env

# MySQL root password (used by both the mysql container and the app)
DB_PASSWORD=change-me

# HS256 signing key for JWTs — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: seeds a ROLE_ADMIN account on first startup.
# Leave blank to skip seeding. /auth/register can only create ROLE_USER.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
